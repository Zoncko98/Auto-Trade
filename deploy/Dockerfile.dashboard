FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY app/dashboard_control.py app/dashboard_server.py app/live_dashboard.py app/live_extension.py ./
COPY app/profile_auth.py app/update_status.py app/broker_market_data.py ./
COPY app/VERSION /app/VERSION
COPY web/ /app/web/
EXPOSE 8765
CMD ["python","-u","/app/dashboard_server.py"]
